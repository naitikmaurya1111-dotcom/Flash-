{
  "entities": {
    "User": {
      "title": "User",
      "description": "Student profile configuration, preferences and accumulated progression statistics",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "The user's unique identifier" },
        "email": { "type": "string", "description": "The user's primary email address" },
        "studentName": { "type": "string", "description": "The student's full name" },
        "studentClass": { "type": "string", "description": "Class standard/grade identifier" },
        "studentPrepTarget": { "type": "string", "description": "Focus target examination e.g. JEE/NEET/CLAT" },
        "themePreset": { "type": "string", "description": "User custom aesthetic dashboard theme preset preference" },
        "themeMode": { "type": "string", "description": "UI layout visual dark/light theme mode" },
        "xp": { "type": "number", "description": "Total active study progression experience points" },
        "lastActiveDate": { "type": "string", "description": "ISO date representing the last active connection day" },
        "displayName": { "type": "string", "description": "User alias for room chat visualization" },
        "dailyTargetMinutes": { "type": "number", "description": "Daily goal study minutes" },
        "timerType": { "type": "string", "description": "Active timer focus type" },
        "pomoFocusDuration": { "type": "number", "description": "Pomodoro active focus duration minutes" },
        "pomoShortBreakDuration": { "type": "number", "description": "Pomodoro short break duration minutes" },
        "pomoLongBreakDuration": { "type": "number", "description": "Pomodoro long break duration minutes" }
      },
      "required": ["studentName", "studentClass", "studentPrepTarget"]
    },
    "Subject": {
      "title": "Subject",
      "description": "Subject folders tracking individual student preparation tracks",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "color": { "type": "string" },
        "icon": { "type": "string" },
        "totalMinutes": { "type": "number" },
        "goalMinutes": { "type": "number" }
      },
      "required": ["id", "name", "color", "icon", "totalMinutes", "goalMinutes"]
    },
    "Task": {
      "title": "Task",
      "description": "Micro-task checklist entries linked to a Subject",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "isCompleted": { "type": "boolean" },
        "subjectId": { "type": "string" }
      },
      "required": ["id", "title", "isCompleted", "subjectId"]
    },
    "StudyLog": {
      "title": "StudyLog",
      "description": "Indelible time-tracked focus index ledger log entries",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "subjectId": { "type": "string" },
        "subjectName": { "type": "string" },
        "durationMinutes": { "type": "number" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "date", "subjectId", "subjectName", "durationMinutes", "timestamp"]
    },
    "Reminder": {
      "title": "Reminder",
      "description": "Physical alert and clock relative time reminder triggers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "time": { "type": "string" },
        "type": { "type": "string" },
        "durationMinutes": { "type": "number" },
        "triggeredAt": { "type": "string" },
        "isActive": { "type": "boolean" },
        "isCompleted": { "type": "boolean" },
        "subjectId": { "type": "string" }
      },
      "required": ["id", "title", "time", "type", "isActive", "isCompleted"]
    },
    "GiftReward": {
      "title": "GiftReward",
      "description": "Student gamification wishlist rewards exchangeable for experience points (XP)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "costXp": { "type": "number" },
        "purchaseUrl": { "type": "string" },
        "category": { "type": "string" },
        "isUnlocked": { "type": "boolean" },
        "isClaimed": { "type": "boolean" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "costXp", "category", "isUnlocked", "isClaimed", "createdAt"]
    },
    "Quest": {
      "title": "Quest",
      "description": "Daily, weekly and milestone gamified structural preparation quests",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "condition": { "type": "string" },
        "xpReward": { "type": "number" },
        "isCompleted": { "type": "boolean" },
        "category": { "type": "string" }
      },
      "required": ["id", "title", "condition", "xpReward", "isCompleted", "category"]
    },
    "XpGainLog": {
      "title": "XpGainLog",
      "description": "Audit trail entries tracking XP accumulation history and levels changes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "reason": { "type": "string" },
        "amount": { "type": "number" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "reason", "amount", "timestamp"]
    },
    "StudyRoom": {
      "title": "StudyRoom",
      "description": "Virtual study lobbies for collaborative sandbox co-studying visual indicators",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "icon": { "type": "string" },
        "currentUsersCount": { "type": "number" },
        "creatorId": { "type": "string" }
      },
      "required": ["id", "name", "category", "description", "icon", "currentUsersCount"]
    },
    "RoomMember": {
      "title": "RoomMember",
      "description": "Live active sub-resource state tracking users inside a StudyRoom",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "avatarSeed": { "type": "string" },
        "isStudying": { "type": "boolean" },
        "activeSubjectName": { "type": "string" },
        "studyDurationTodayMinutes": { "type": "number" },
        "activeSeconds": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "avatarSeed", "isStudying", "activeSubjectName", "studyDurationTodayMinutes", "activeSeconds"]
    },
    "RoomChat": {
      "title": "RoomChat",
      "description": "Instant text message documents within a StudyRoom's real-time chat log",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userAvatarSeed": { "type": "string" },
        "text": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "userId", "userName", "userAvatarSeed", "text", "timestamp"]
    },
    "KeepNote": {
      "title": "KeepNote",
      "description": "Keep notes in user workspace",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "title", "body", "timestamp"]
    },
    "ExamTarget": {
      "title": "ExamTarget",
      "description": "Custom examination target dates, preparation levels, checklists, and difficulty ratings",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "subjectId": { "type": "string" },
        "examDate": { "type": "string" },
        "targetGrade": { "type": "string" },
        "preparationLevel": { "type": "number" },
        "difficulty": { "type": "string" },
        "checklist": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "text": { "type": "string" },
              "isDone": { "type": "boolean" }
            },
            "required": ["id", "text", "isDone"]
          }
        }
      },
      "required": ["id", "title", "subjectId", "examDate", "targetGrade", "preparationLevel", "difficulty", "checklist"]
    },
    "GpaCourse": {
      "title": "GpaCourse",
      "description": "GPA course credit hours and targets mapped inside target roadmap",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "creditHours": { "type": "number" },
        "currentGradePercent": { "type": "number" },
        "targetGradePercent": { "type": "number" },
        "remainingWeightPercent": { "type": "number" }
      },
      "required": ["id", "name", "creditHours", "currentGradePercent", "targetGradePercent", "remainingWeightPercent"]
    }
  },
  "firestore": {
    "/users/{userId}": { "schema": "User", "description": "Student root profile document with global preferences" },
    "/users/{userId}/subjects/{subjectId}": { "schema": "Subject", "description": "A customized subject folder" },
    "/users/{userId}/tasks/{taskId}": { "schema": "Task", "description": "Micro-task checklist item linked to a specified subject" },
    "/users/{userId}/studyLogs/{logId}": { "schema": "StudyLog", "description": "Unbiased and validated backdate focus records of study minutes" },
    "/users/{userId}/reminders/{reminderId}": { "schema": "Reminder", "description": "Relative countdown and clock-based micro-reminder triggers" },
    "/users/{userId}/rewards/{rewardId}": { "schema": "GiftReward", "description": "Claimable exchange-eligible gamified reward triggers" },
    "/users/{userId}/quests/{questId}": { "schema": "Quest", "description": "Preparation target challenges linked to active performance tiers" },
    "/users/{userId}/xpLogs/{xpLogId}": { "schema": "XpGainLog", "description": "Audit indexes mapping experience gains across study times" },
    "/users/{userId}/keepNotes/{noteId}": { "schema": "KeepNote", "description": "Custom Keep notes inside user workspace" },
    "/users/{userId}/exams/{examId}": { "schema": "ExamTarget", "description": "Target examinations and associated preparation checklists" },
    "/users/{userId}/gpaCourses/{courseId}": { "schema": "GpaCourse", "description": "Interactive GPA calculations and progress criteria" },
    "/studyRooms/{roomId}": { "schema": "StudyRoom", "description": "Collaborative digital libraries representing student lobby floors" },
    "/studyRooms/{roomId}/members/{memberId}": { "schema": "RoomMember", "description": "Dynamic online user cards signaling current room membership" },
    "/studyRooms/{roomId}/chats/{chatId}": { "schema": "RoomChat", "description": "Live board message logs enabling group notes exchanges" }
  }
}
