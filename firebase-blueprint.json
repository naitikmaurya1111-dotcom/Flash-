{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with configuration",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "dailyTargetMinutes": { "type": "integer" },
        "xp": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "email"]
    },
    "Subject": {
      "title": "Subject",
      "description": "A study subject",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "color": { "type": "string" },
        "icon": { "type": "string" },
        "totalMinutes": { "type": "integer" },
        "goalMinutes": { "type": "integer" }
      },
      "required": ["id", "name", "color", "icon", "totalMinutes", "goalMinutes"]
    },
    "Task": {
      "title": "Task",
      "description": "A planner task",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "isCompleted": { "type": "boolean" },
        "subjectId": { "type": "string" }
      },
      "required": ["id", "title", "isCompleted", "subjectId"]
    },
    "StudyLog": {
      "title": "StudyLog",
      "description": "A study session log",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "subjectId": { "type": "string" },
        "subjectName": { "type": "string" },
        "durationMinutes": { "type": "integer" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "date", "subjectId", "subjectName", "durationMinutes", "timestamp"]
    },
    "GiftReward": {
      "title": "GiftReward",
      "description": "A motivational self-reward item purchasable by user's study XP",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "costXp": { "type": "integer" },
        "purchaseUrl": { "type": "string" },
        "category": { "type": "string", "enum": ["Tech Gadget", "Desk Setup", "Daily Treats", "Books & Supplies", "Custom Reward"] },
        "isUnlocked": { "type": "boolean" },
        "isClaimed": { "type": "boolean" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "costXp", "purchaseUrl", "category", "isUnlocked", "isClaimed", "createdAt"]
    },
    "QuestChallenge": {
      "title": "QuestChallenge",
      "description": "Accountability study quests that award extra progress XP",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "condition": { "type": "string" },
        "xpReward": { "type": "integer" },
        "isCompleted": { "type": "boolean" },
        "category": { "type": "string", "enum": ["daily", "weekly", "milestone"] }
      },
      "required": ["id", "title", "condition", "xpReward", "isCompleted", "category"]
    },
    "XpGainLog": {
      "title": "XpGainLog",
      "description": "History logs tracking visual points of XP milestones",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "reason": { "type": "string" },
        "amount": { "type": "integer" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "reason", "amount", "timestamp"]
    },
    "StudyRoom": {
      "title": "StudyRoom",
      "description": "A collaborative virtual study room in YPT mode",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "icon": { "type": "string" },
        "currentUsersCount": { "type": "integer" },
        "creatorId": { "type": "string" }
      },
      "required": ["id", "name", "category", "description", "creatorId"]
    },
    "RoomMember": {
      "title": "RoomMember",
      "description": "A student in an active study room with synced ticking clock",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "avatarSeed": { "type": "string" },
        "isStudying": { "type": "boolean" },
        "activeSubjectName": { "type": "string" },
        "studyDurationTodayMinutes": { "type": "integer" },
        "activeSeconds": { "type": "integer" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "isStudying", "activeSubjectName", "studyDurationTodayMinutes", "activeSeconds"]
    },
    "RoomChat": {
      "title": "RoomChat",
      "description": "Real-time conversation within a study room",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userAvatarSeed": { "type": "string" },
        "text": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "userName", "text"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Core profile for each student"
    },
    "/users/{userId}/subjects/{subjectId}": {
      "schema": "Subject",
      "description": "Active study subtopics with cumulative minutes"
    },
    "/users/{userId}/tasks/{taskId}": {
      "schema": "Task",
      "description": "Tasks associated to subjects or general"
    },
    "/users/{userId}/studyLogs/{logId}": {
      "schema": "StudyLog",
      "description": "Daily study history logs"
    },
    "/users/{userId}/rewards/{rewardId}": {
      "schema": "GiftReward",
      "description": "Self-rewards goals tracked per student user"
    },
    "/users/{userId}/quests/{questId}": {
      "schema": "QuestChallenge",
      "description": "Daily/weekly accountability quests synced in real time"
    },
    "/users/{userId}/xpLogs/{logId}": {
      "schema": "XpGainLog",
      "description": "Detailed XP log transaction records of study sessions"
    },
    "/studyRooms/{roomId}": {
      "schema": "StudyRoom",
      "description": "Browse and discover shared virtual rooms"
    },
    "/studyRooms/{roomId}/members/{memberId}": {
      "schema": "RoomMember",
      "description": "Active profiles inside a study room"
    },
    "/studyRooms/{roomId}/chats/{chatId}": {
      "schema": "RoomChat",
      "description": "Live group messages for accountability"
    }
  }
}
