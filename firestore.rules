rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{doc=**} { allow read, write: if false; }
    match /test/{id} { allow read: if true; }

    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isEmailVerified() { return isSignedIn() && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'google.com' || request.auth.token.firebase.sign_in_provider == 'password'); }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    function isValidUser(d, uid) {
      return (d.userId == null || d.userId == uid) && (d.email == null || d.email is string) && (d.dailyTargetMinutes == null || d.dailyTargetMinutes >= 0);
    }

    match /users/{userId} {
      allow get, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidUser(request.resource.data, userId);

      // Secure all user subcollections dynamically with high-performance rules
      match /{subcollection}/{id} {
        allow list, get, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isEmailVerified() && isValidId(id);
        allow update: if isOwner(userId);
      }
    }

    match /unlockedAccounts/{email} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (
        request.auth.token.email == 'mauryanaitik9999@gmail.com' ||
        request.auth.token.email == 'naitikmaurya1111@gmail.com'
      );
    }
  }
}
