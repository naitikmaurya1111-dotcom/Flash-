rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{doc=**} { allow read, write: if false; }
    match /test/{id} { allow read: if true; }

    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isEmailVerified() { return isSignedIn() && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'google.com' || request.auth.token.firebase.sign_in_provider == 'password'); }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    function isValidUser(d, uid) {
      return (d.userId == null || d.userId == uid) && (d.email == null || d.email is string) && (d.dailyTargetMinutes == null || d.dailyTargetMinutes >= 0);
    }

    match /users/{userId} {
      allow get, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidUser(request.resource.data, userId);

      match /subjects/{id} {
        allow list, get, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isEmailVerified() && isValidId(id);
        allow update: if isOwner(userId) && request.resource.data.name is string;
      }
      match /tasks/{id} {
        allow list, get, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isEmailVerified() && isValidId(id);
        allow update: if isOwner(userId);
      }
      match /studyLogs/{id} {
        allow list, get, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isEmailVerified() && isValidId(id);
        allow update: if isOwner(userId);
      }
      match /rewards/{id} {
        allow list, get, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isEmailVerified() && isValidId(id);
        allow update: if isOwner(userId);
      }
      match /quests/{id} {
        allow list, get, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isEmailVerified() && isValidId(id);
        allow update: if isOwner(userId);
      }
      match /xpLogs/{id} {
        allow list, get, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isEmailVerified() && isValidId(id);
        allow update: if isOwner(userId);
      }
      match /reminders/{id} {
        allow list, get, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isEmailVerified() && isValidId(id);
        allow update: if isOwner(userId);
      }
      match /keepNotes/{id} {
        allow list, get, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isEmailVerified() && isValidId(id);
        allow update: if isOwner(userId);
      }
    }

    match /studyRooms/{roomId} {
      allow list, get: if true;
      allow create: if isSignedIn() && isEmailVerified() && isValidId(roomId);
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && resource.data.creatorId == request.auth.uid;

      match /members/{memberId} {
        allow list, get: if isSignedIn();
        allow create, update, delete: if isSignedIn() && request.auth.uid == memberId;
      }
      match /chats/{chatId} {
        allow list, get: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid && isValidId(chatId);
        allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      }
    }
  }
}
